{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "env": {
    "node": true,
    "browser": true,
    "es2022": true
  },
  "ignorePatterns": ["dist/", "node_modules/", "coverage/", "scripts/"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      { "args": "after-used", "caughtErrors": "none", "argsIgnorePattern": "^_" }
    ]
  },
  "overrides": [
    {
      "files": ["test/**/*.ts"],
      "rules": {
        "@typescript-eslint/no-var-requires": "off"
      }
    },
    {
      "files": ["src/core/**/*.ts", "src/client/**/*.ts", "src/server/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/scanner/*", "**/scanner/**"],
                "message": "sideEffects derivation is scanner-only (C-1); core/IR must not import the scanner proposer."
              }
            ]
          }
        ]
      }
    }
  ]
}
